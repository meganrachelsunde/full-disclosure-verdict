# Environment variable names only — no values.
# This file documents expected configuration; it does not configure anything.
# No document-upload or real-record-handling functionality exists yet,
# so none of these touch patient or case records.

# Intake-form email notifications (/api/contact). Configure ONE sender:
# Resend (verified domain, preferred if set) or Web3Forms (no domain
# setup; key from web3forms.com, delivers to that account's email).
# With neither set the endpoint returns 503 and the form falls back to
# opening the visitor's own email client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
WEB3FORMS_ACCESS_KEY=

# Google Search Console HTML-tag verification (optional — DNS TXT
# verification needs no env var).
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional — the
# gtag scripts render only when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe — the secret key is the only one the build reads. /api/checkout
# creates a hosted Checkout Session for the fixed screening fee; no card
# details are entered on this site and no payment data is stored here.
# Test keys (sk_test_…) exercise the whole flow without moving money;
# live keys (sk_live_…) require the Stripe account to be activated.
STRIPE_SECRET_KEY=

# Optional. Overrides the origin used for Stripe's success/cancel return
# URLs. Unset, the request's own origin is used, which is correct for
# both preview and production deployments.
NEXT_PUBLIC_SITE_URL=
